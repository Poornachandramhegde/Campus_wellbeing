# ==========================================================
# Server Configuration
# ==========================================================
PORT=5000

# ==========================================================
# Local MySQL Database Configuration (Default Development)
# ==========================================================
# DB_HOST=localhost refers to the MySQL instance running on YOUR local machine.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_REAL_AIVEN_PASSWORD
DB_NAME=erp_wellbeing
# DB_SSL is omitted or set to false for local MySQL without TLS/SSL
DB_SSL=false

# ==========================================================
# Production Aiven MySQL Database Configuration
# ==========================================================
# When deploying or connecting to Aiven MySQL, supply the credentials
# found in your Aiven Console under "Connection information".
#
# Option A: Individual Variables (Recommended)
# DB_HOST=mysql-<service-name>-<project-name>.aivencloud.com
# DB_PORT=12345
# DB_USER=avnadmin
# DB_PASSWORD=YOUR_AIVEN_PASSWORD
# DB_NAME=defaultdb
#
# SSL Settings for Aiven (Aiven requires SSL connections):
# DB_SSL=true
#
# SSL CA Certificate (choose one of the following methods):
# 1) Path to downloaded ca.pem file:
# DB_SSL_CA_PATH=./ca.pem
#
# 2) Or raw PEM certificate string (useful for cloud environments like Render/Railway):
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
#
# Optional: Set to false only if bypassing strict CA verification in staging/testing
# DB_SSL_REJECT_UNAUTHORIZED=true
#
# Option B: Aiven Service URI (Alternative)
# DATABASE_URL=mysql://avnadmin:YOUR_AIVEN_PASSWORD@mysql-<service-name>-<project-name>.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED


# ==========================================================
# JWT Authentication Configuration
# ==========================================================
JWT_SECRET=YOUR_DEVELOPMENT_JWT_SECRET_KEY
JWT_EXPIRES_IN=1d

# ==========================================================
# Google Calendar & Meet Integration (Optional / Local Dev)
# ==========================================================
# Required only for online session scheduling with Google Meet links.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Timezone for appointment scheduling
COUNSELLING_TIMEZONE=Asia/Kolkata

# ==========================================================
# SMTP Email Service Configuration (Optional / Local Dev)
# ==========================================================
# Required only for automated booking notification emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=YOUR_SMTP_EMAIL@gmail.com
SMTP_PASSWORD=YOUR_SMTP_APP_PASSWORD
