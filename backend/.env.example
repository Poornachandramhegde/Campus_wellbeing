# ==========================================================
# Server Configuration
# ==========================================================
PORT=5000

# ==========================================================
# Local MySQL Database Configuration
# ==========================================================
# DB_HOST=localhost refers to the MySQL instance running on YOUR local machine.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_LOCAL_MYSQL_PASSWORD
DB_NAME=erp_wellbeing

# ==========================================================
# JWT Authentication Configuration
# ==========================================================
JWT_SECRET=YOUR_DEVELOPMENT_JWT_SECRET_KEY
JWT_EXPIRES_IN=1d

# ==========================================================
# Google Calendar & Meet Integration (Optional / Local Dev)
# ==========================================================
# Required only for online session scheduling with Google Meet links.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Timezone for appointment scheduling
COUNSELLING_TIMEZONE=Asia/Kolkata

# ==========================================================
# SMTP Email Service Configuration (Optional / Local Dev)
# ==========================================================
# Required only for automated booking notification emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=YOUR_SMTP_EMAIL@gmail.com
SMTP_PASSWORD=YOUR_SMTP_APP_PASSWORD
